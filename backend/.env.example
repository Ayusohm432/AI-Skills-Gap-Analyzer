# Uncomment the following line for deployed MongoDB Atlas URL
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Alternatively, use local MongoDB for local execution! 
MONGO_URL=mongodb://localhost:27017

SECRET_KEY=your-secret-key-here

RENDER_EXTERNAL_URL=your render external url

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=7

# Uncomment the following line for deployed frontend URL
# FRONTEND_URL=https://my-skill-gap-app.vercel.app

# Alternatively, allow frontend for local execution!
FRONTEND_URL=http://localhost:5173

# Tesseract OCR binary path (only needed if running outside Docker on Windows)
# Linux/Docker: leave commented out — Tesseract is on PATH automatically.
# Windows (if installed via UB-Mannheim): uncomment and set the correct path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ML model artifact version to load at startup.
# Maps to: backend/models/ml_models/<ML_MODEL_VERSION>/
# Change this when you promote a new trained version (e.g. v1.1, v2.0).
ML_MODEL_VERSION=v1.0

# Admin API key for model version management.
# Required in the X-Admin-Key header to call POST /api/v1/models/activate/:version.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your-admin-api-key-here

# Optional: GitHub Personal Access Token for POST /api/v1/analyze/github.
# Without this token, GitHub enforces a 60 req/hr unauthenticated rate limit.
# With it, the limit rises to 5 000 req/hr.
# No special scopes are needed — public repository access is sufficient.
# Generate at: https://github.com/settings/tokens (select "Generate new token (classic)")
GITHUB_TOKEN=ghp_your_token_here

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Controls which AI backend is used for Mock Interview and skill domain resolution.
# Options: "gemini" (default, cloud) | "ollama" (local, free, private)
LLM_PROVIDER=gemini

# ── Option A: Google Gemini (cloud, requires API key) ────────────────────────
# Used for: Conversational Mock Interview, Skill Domain Classification,
#           AI-generated interview questions in resume analysis.
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Option B: Ollama (local, free, no API key needed) ────────────────────────
# Requires Ollama to be running locally: https://ollama.ai
# Step 1 — Install Ollama:   https://ollama.ai/download
# Step 2 — Pull a model:     ollama pull llama3.2
# Step 3 — Start server:     ollama serve
# Step 4 — Set LLM_PROVIDER=ollama above and configure below.
#
# Recommended models (pull one):
#   ollama pull llama3.2       # Fast, good quality (3B)
#   ollama pull llama3.1       # Better reasoning (8B)
#   ollama pull mistral        # Excellent instruction following (7B)
#   ollama pull codellama      # Best for coding interviews (7B)
#   ollama pull deepseek-r1:8b # Strong reasoning (8B)
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Phase 4: Market Demand Data (optional — enables live Adzuna fetch) ──────
# Without these, the system uses high-quality seeded data with weekly jitter.
# Sign up at: https://developer.adzuna.com/
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# ADZUNA_COUNTRY=in    # Country code: in=India, us=USA, gb=UK (default: in)
