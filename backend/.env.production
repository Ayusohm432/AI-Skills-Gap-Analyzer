# .env.production — Production configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# URLs (Set these in your Production Provider like Render/AWS)
FRONTEND_URL=https://your-production-app.com
OAUTH_REDIRECT_BASE=https://your-api-server.com
RENDER_EXTERNAL_URL=https://your-api-server.com

# App Config
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ML_MODEL_VERSION=v1.0

# Database & Security (MUST be set in Production Provider secrets)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/prod
SECRET_KEY=production_secret_key_required
ADMIN_API_KEY=production_admin_key_required

# API Tokens (MUST be set in Production Provider secrets)
GITHUB_TOKEN=production_github_token
GEMINI_API_KEY=production_gemini_key

# LLM Defaults
LLM_PROVIDER=gemini

# Adzuna
ADZUNA_APP_ID=production_adzuna_id
ADZUNA_APP_KEY=production_adzuna_key
ADZUNA_COUNTRY=in

# OAuth (MUST be set in Production Provider secrets)
GOOGLE_CLIENT_ID=production_google_id
GOOGLE_CLIENT_SECRET=production_google_secret
GITHUB_CLIENT_ID=production_github_id
GITHUB_CLIENT_SECRET=production_github_secret

# Supabase
SUPABASE_URL=https://prod.supabase.co
SUPABASE_SERVICE_KEY=production_supabase_key

# Sentry performance tracking
SENTRY_TRACES_SAMPLE_RATE=0.1
