# .env.development — Shared development defaults
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# URLs
FRONTEND_URL=http://localhost:5173/AI-Skills-Gap-Analyzer/
OAUTH_REDIRECT_BASE=http://localhost:8000
RENDER_EXTERNAL_URL=http://localhost:8000

# App Config
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ML_MODEL_VERSION=v1.0

# Database & Security (Use .env.local for your actual keys)
MONGO_URL=mongodb://localhost:27017/ai_skills_gap
SECRET_KEY=dev_secret_key_placeholder
ADMIN_API_KEY=dev_admin_key_placeholder

# API Tokens (Placeholders - Override in .env.local)
GITHUB_TOKEN=ghp_development_token_placeholder
GEMINI_API_KEY=AIza_development_key_placeholder

# LLM Defaults
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Adzuna
ADZUNA_APP_ID=adz_dev_id
ADZUNA_APP_KEY=adz_dev_key
ADZUNA_COUNTRY=in

# OAuth (Placeholders - Override in .env.local)
GOOGLE_CLIENT_ID=google_dev_id
GOOGLE_CLIENT_SECRET=google_dev_secret
GITHUB_CLIENT_ID=github_dev_id
GITHUB_CLIENT_SECRET=github_dev_secret

# Supabase
SUPABASE_URL=https://dev.supabase.co
SUPABASE_SERVICE_KEY=sb_dev_key
